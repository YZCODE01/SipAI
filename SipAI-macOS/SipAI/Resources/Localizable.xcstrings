        }
      }
    },
    "%@ did not answer." : {
      "comment" : "Skills: an agent's own tool gave no answer to a switch, or could not be run; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有响应。"
          }
        }
      }
    },
    "%@ did not update to %@: its download timed out. %@ stops a download that takes longer than %lld minutes." : {
      "comment" : "Sidebar notice beside the logo, the whole sentence (its hover and VoiceOver): Claude Code's update did not land because Claude Code itself stops a download that takes longer than its time limit; its Update button tries again. Placeholders are the tool's label, the version, the tool's label again and the limit in minutes",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 未能更新至 %2$@：下载超时。%3$@ 会停止超过 %4$lld 分钟的下载。"
          }
        }
      }
    },
    "%@ did not update to %@." : {
      "comment" : "Sidebar notice beside the logo, the whole sentence of a tool's update that ran and did not land; its Update button tries again. Placeholders are the tool's label and the version",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 未能更新至 %2$@。"
          }
        }
      }
    },
    "%@ didn’t find the skill “%@”, so your message was sent without it." : {
      "comment" : "Runner notice: the agent did not know the chosen skill, and the message went on its own; placeholders are the agent label and the skill",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有找到技能“%@”，你的消息已在未加载该技能的情况下发送。"
          }
        }
      }
    },
    "%@ didn’t list its skills, so “%@” couldn’t be checked." : {
      "comment" : "Scheduled-run failure: the agent's own skill list did not answer, so a task's skill could not be confirmed; placeholders are the agent label and the skill",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ didn’t list its skills, so “%2$@” couldn’t be checked."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 没有列出它的技能，因此无法确认“%2$@”。"
          }
        }
      }
    },
    "%@ didn’t take the message now: %@" : {
      "comment" : "Above the agent composer: a message steered into the running turn was refused; placeholders are the agent label and the agent's own words",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 现在没有接收这条消息：%@"
          }
        }
