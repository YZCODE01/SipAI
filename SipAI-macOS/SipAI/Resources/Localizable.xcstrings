    "The skill changed on disk in the meantime, so SipAI left it alone. Try again." : {
      "comment" : "Skills: a share or a fix refused because the skill's file changed after it was checked",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此技能在此期间已在磁盘上被修改，SipAI 未作改动。请重试。"
          }
        }
      }
    },
    "The skill changed on disk while you were editing it. Close and open it again." : {
      "comment" : "Skills: an edit refused because the file changed meanwhile",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑期间此技能已在磁盘上被修改。请关闭后重新打开。"
