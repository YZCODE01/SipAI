        }
      }
    },
    "Its name has a space or a slash in it, so it can’t be called by name." : {
      "comment" : "Skill chip: a Kimi Code skill whose name cannot be written as a /skill: command",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其名称中含有空格或斜杠，因此无法按名称调用。"
