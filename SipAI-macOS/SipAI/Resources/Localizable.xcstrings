    },
    "Its link points at a folder that is gone. Delete it to clean up." : {
      "comment" : "Skills detail: a broken link",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其链接指向的文件夹已不存在。删除它即可清理。"
          }
        }
