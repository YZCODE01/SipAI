    },
    "%@ label" : {
      "comment" : "Settings: label shown above an agent's messages, e.g. 'Claude Code label'",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 名称"
          }
        }
      }
    },
    "%@ listed no chat models. Enter a model ID manually below." : {
      "comment" : "Model setup: healthy response but empty list",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未返回任何对话模型。请在下方手动输入模型 ID。"
          }
        }
      }
    },
    "%@ lists its models publicly, so the key was not checked until now — and it was rejected: %@" : {
      "comment" : "Model setup: the provider's public model list hid a bad API key",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ lists its models publicly, so the key was not checked until now — and it was rejected: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的模型列表是公开的，因此密钥直到现在才被验证——而它被拒绝了：%@"
          }
        }
      }
    },
    "%@ publishes no model list — enter a model id manually." : {
      "comment" : "Model setup: fallback note for a provider with no /models endpoint",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未提供模型列表——请手动输入模型 ID。"
          }
        }
      }
    },
    "%@ rejected the attached file — it may not accept images or PDFs. Pick a model that does, or remove the attachment.\n\n%@" : {
      "comment" : "Error when a provider refuses a request carrying an image or PDF",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了所附文件——它可能不支持图片或 PDF。请改用支持的模型，或移除附件。\n\n%@"
          }
        }
      }
    },
    "%@ runs non-interactively here, so it approves its own tool calls. Its CLI rejects a permission mode on a headless run, so there is nothing to choose." : {
      "comment" : "Hover hint on the Kimi auto-approve chip; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在这里以非交互方式运行，会自行批准工具调用。它的 CLI 不接受在无界面运行时指定权限模式，因此这里没有可选项。"
          }
        }
      }
    },
    "%@ session" : {
