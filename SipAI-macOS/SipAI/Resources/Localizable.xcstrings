    "%@ (branch)" : {
      "comment" : "Title of a chat branched from another; placeholder is the original title",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（分支）"
          }
        }
      }
    },
    "%@ and %@" : {
      "comment" : "Joins the last agent name onto the list of the others: “A, B and C”",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@ CLI is installed but not signed in. Sessions sync read-only — configure it (e.g. codex login or an API key) to start new sessions." : {
      "comment" : "Sidebar hint when an agent CLI exists but has no working auth",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ CLI 已安装但未登录。会话以只读方式同步——请先完成配置（例如 codex login 或填入 API 密钥）才能新建会话。"
          }
        }
      }
    },
    "%@ could not be read." : {
      "comment" : "Attachment refused: the file could not be opened or decoded",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@。"
          }
        }
      }
    },
    "%@ decides, using your codex config" : {
      "comment" : "Hint for the no-override sandbox row on a codex session; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 %@ 决定，使用你的 codex 配置"
          }
        }
      }
    },
    "%@ decides; approvals appear here" : {
      "comment" : "Hint for the no-override permission mode row; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 %@ 决定；授权请求会显示在这里"
          }
        }
      }
    },
    "%@ exited with code %d." : {
      "comment" : "Fallback exit-code message when stderr is empty; placeholder is the agent name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ exited with code %2$d."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已退出，退出码 %d。"
          }
        }
      }
    },
    "%@ has %lld pages — the limit is %lld." : {
      "comment" : "Attachment refused: PDF has too many pages",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 有 %lld 页——上限为 %lld 页。"
          }
        }
      }
    },
    "%@ has no text layer, and %@ cannot read PDFs directly. Use a Claude model or an OpenAI Responses model, or attach the pages as images." : {
      "comment" : "Error when a scanned PDF is sent to a provider that takes no native PDF",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有文本层，而 %@ 无法直接读取 PDF。请改用 Claude 模型或 OpenAI Responses 模型，或将页面以图片形式附加。"
          }
        }
      }
    },
    "%@ has no text to read." : {
      "comment" : "Attachment refused: an empty file, or a scanned PDF with no text layer",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中没有可读取的文本。"
          }
        }
      }
    },
    "%@ has slash commands only in its own terminal. This will be sent as an ordinary message." : {
      "comment" : "Composer hint when a codex/kimi draft opens with a slash command; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的斜杠命令只能在它自己的终端里使用。这条内容将作为普通消息发送。"
          }
        }
      }
    },
    "%@ has too many pixels to process (over %lld megapixels)." : {
      "comment" : "Attachment refused: image dimensions exceed the decode ceiling",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 像素过多，无法处理（超过 %lld 百万像素）。"
          }
        }
      }
    },
    "%@ is already configured under %@ — remove it there first." : {
      "comment" : "Model setup: refusing to tick a model id that already exists under a different provider",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is already configured under %2$@ — remove it there first."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在 %@ 下配置——请先在那里移除。"
          }
        }
      }
    },
    "%@ is installed but not signed in." : {
      "comment" : "Scheduled-run failure: agent CLI lacks auth",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已安装但未登录。"
