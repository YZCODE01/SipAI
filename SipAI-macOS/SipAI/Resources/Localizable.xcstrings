    },
    "The endpoint may not be up to date — editing it could solve this." : {
      "comment" : "Model setup: hint next to a failed model fetch",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接入地址可能已过时——修改它或许能解决此问题。"
          }
        }
      }
    },
    "The endpoint must be a full URL starting with http:// or https://." : {
