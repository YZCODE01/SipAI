    },
    "The skills every folder has" : {
      "comment" : "Skills: folder menu tooltip with no folder",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有文件夹都有的技能"
