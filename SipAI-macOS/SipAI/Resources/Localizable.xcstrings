{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "“%@” — not a valid cron expression" : {
      "comment" : "Scheduled-task detail: unparseable cron\nScheduled-task editor: schedule summary for an unparseable expression",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”——不是有效的 cron 表达式"
          }
        }
      }
    },
    "“%@” and all its chats are removed. This cannot be undone." : {
      "comment" : "Body of the chat-group delete confirmation",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”及其中的所有对话都会被移除。此操作无法撤销。"
          }
        }
      }
    },
    "“%@” and every run it made are removed for every app that reads them — SipAI, the CLI, and the desktop app. This cannot be undone." : {
      "comment" : "Body of the Delete all confirmation for a scheduled task whose definition is already gone",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”及其所有运行记录会对所有读取它们的 App 一并移除——SipAI、CLI 以及桌面 App。此操作无法撤销。"
          }
        }
      }
    },
    "“%@” and its messages are removed. This cannot be undone." : {
      "comment" : "Body of the chat delete confirmation",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”及其消息都会被移除。此操作无法撤销。"
          }
        }
      }
    },
    "“%@” can't be opened. Choose the folder for this session." : {
      "comment" : "Folder picker message when a group's recorded path is not an openable directory",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开“%@”。请为此会话选择文件夹。"
          }
        }
      }
    },
    "“%@” goes away. Its sessions are kept and move to Ungrouped." : {
      "comment" : "Explains that deleting a group never deletes sessions",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将被移除。其中的会话会保留并移到「未分组」。"
          }
        }
      }
    },
    "“%@” is removed for every app that reads it — SipAI, the CLI, and the desktop app. This cannot be undone." : {
      "comment" : "Body of the session delete confirmation",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”会对所有读取它的 App 一并移除——SipAI、CLI 以及桌面 App。此操作无法撤销。"
          }
        }
      }
    },
    "“%@” stops running and its definition is removed. Past run sessions are kept." : {
      "comment" : "Body of the scheduled-task delete confirmation",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将停止运行，其定义会被移除。过去的运行会话会保留。"
          }
        }
      }
    },
    "“%@” stops running, its definition is removed, and every run it made is removed for every app that reads them — SipAI, the CLI, and the desktop app. This cannot be undone." : {
      "comment" : "Body of the scheduled-task Delete all confirmation",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将停止运行，其定义会被移除，它的所有运行记录也会对所有读取它们的 App 一并移除——SipAI、CLI 以及桌面 App。此操作无法撤销。"
          }
        }
      }
    },
    "%@ — %@ is not supported. Attach an image, a PDF, or a text file." : {
      "comment" : "Attachment refused: unsupported file type",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@——不支持 %@。请附加图片、PDF 或文本文件。"
          }
        }
      }
    },
    "%@ — %@, its text is included in the message" : {
      "comment" : "Tooltip for an attached text file chip",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@——%@，其文本内容已包含在消息中"
          }
        }
      }
    },
    "%@ — %@, sent as a document with this message" : {
      "comment" : "Tooltip for an attached PDF chip",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@——%@，将作为文档随本条消息发送"
          }
        }
      }
    },
    "%@ — %@, sent as an image with this message" : {
      "comment" : "Tooltip for an attached image chip",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@——%@，将作为图片随本条消息发送"
          }
        }
      }
    },
    "%@ — an image can only be attached to a NEW %@ chat. Start one, or attach a text file or a PDF." : {
      "comment" : "Image refused on a resumed kimi session; placeholders are the file name and the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@——只能在新的 %@ 对话中附加图片。请新建对话，或附加文本文件或 PDF。"
          }
        }
      }
    },
    "%@ — failed" : {
      "comment" : "Scheduled-task detail: last run outcome",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 失败"
          }
        }
      }
    },
    "%@ — images can only be attached in Chat only mode." : {
      "comment" : "Image refused because Chat only is not available; placeholder is the file name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@——仅在“仅对话”模式下可附加图片。"
          }
        }
      }
    },
    "%@ — running" : {
      "comment" : "Scheduled-task detail: last run outcome",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 运行中"
          }
        }
      }
    },
    "%@ — succeeded" : {
      "comment" : "Scheduled-task detail: last run outcome",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 成功"
          }
        }
      }
    },
    "%@ (branch)" : {
      "comment" : "Title of a chat branched from another; placeholder is the original title",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（分支）"
          }
        }
      }
    },
    "%@ and %@" : {
      "comment" : "Joins the last agent name onto the list of the others: “A, B and C”",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@ and %lld more" : {
      "comment" : "Update-hold sheet: the named sessions plus a count of the rest; placeholders are a list and a number",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 及另外 %lld 个"
          }
        }
      }
    },
    "%@ approves its own tool calls on a headless run" : {
      "comment" : "Hint under the kimi Auto-approve mode row; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在无界面运行时会自行批准工具调用"
          }
        }
      }
    },
    "%@ can look things up on the web but can't read or change files. Attach files with +." : {
      "comment" : "Hint under the Chat only mode row; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可以上网查找信息，但无法读取或修改文件。用 + 附加文件。"
          }
        }
      }
    },
    "%@ could not be asked to change its config. Add the line below to ~/.codex/config.toml yourself, above any [section] header." : {
      "comment" : "Help card: no codex app-server answered; placeholder is the Codex label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法让 %@ 修改自己的配置。请自行把下面这一行加入 ~/.codex/config.toml，放在任何 [section] 标题之前。"
          }
        }
      }
    },
    "%@ could not be read." : {
      "comment" : "Attachment refused: the file could not be opened or decoded",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@。"
          }
        }
      }
    },
    "%@ decides, using your codex config" : {
      "comment" : "Hint for the no-override sandbox row on a codex session; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 %@ 决定，使用你的 codex 配置"
          }
        }
      }
    },
    "%@ decides; approvals appear here" : {
      "comment" : "Hint for the no-override permission mode row; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 %@ 决定；授权请求会显示在这里"
          }
        }
      }
    },
    "%@ declined the change: %@" : {
      "comment" : "Help card: codex refused the config write; placeholders are the Codex label and Codex's own message",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了这项更改：%@"
          }
        }
      }
    },
    "%@ did not answer, so the branch was not created." : {
      "comment" : "Branch error when the agent's own fork call got no reply; placeholder is the agent's label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有响应，分支未创建。"
          }
        }
      }
    },
    "%@ exited with code %d." : {
      "comment" : "Fallback exit-code message when stderr is empty; placeholder is the agent name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ exited with code %2$d."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已退出，退出码 %d。"
          }
        }
      }
    },
    "%@ fast mode is paid only from usage credits." : {
      "comment" : "Fast mode switch on a Claude plan: fast mode is paid from usage credits alone, never from the plan's own limits; the placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的快速模式只从额外用量中扣费。"
          }
        }
      }
    },
    "%@ has %lld pages — the limit is %lld." : {
      "comment" : "Attachment refused: PDF has too many pages",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 有 %lld 页——上限为 %lld 页。"
          }
        }
      }
    },
    "%@ has no model configured, so a new session cannot start." : {
      "comment" : "Runner error: kimi's config.toml names no default_model; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未配置模型，无法开始新会话。"
          }
        }
      }
    },
    "%@ has no switch for this in its own interface. The setting is one line in ~/.codex/config.toml, model_context_window — a single value that %@ clamps to each model's own maximum:" : {
      "comment" : "Help card, paragraph 2; placeholders are the Codex label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 自身的界面里没有这个开关。这项设置是 ~/.codex/config.toml 中的一行 model_context_window——一个全局值，%@ 会把它限制在每个模型各自的上限以内："
          }
        }
      }
    },
    "%@ has no text layer, and %@ cannot read PDFs directly. Use a Claude model or an OpenAI Responses model, or attach the pages as images." : {
      "comment" : "Error when a scanned PDF is sent to a provider that takes no native PDF",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有文本层，而 %@ 无法直接读取 PDF。请改用 Claude 模型或 OpenAI Responses 模型，或将页面以图片形式附加。"
          }
        }
      }
    },
    "%@ has no text to read." : {
      "comment" : "Attachment refused: an empty file, or a scanned PDF with no text layer",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中没有可读取的文本。"
          }
        }
      }
    },
    "%@ has slash commands only in its own terminal. This will be sent as an ordinary message." : {
      "comment" : "Composer hint when a codex/kimi draft opens with a slash command; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的斜杠命令只能在它自己的终端里使用。这条内容将作为普通消息发送。"
          }
        }
      }
    },
    "%@ has too many pixels to process (over %lld megapixels)." : {
      "comment" : "Attachment refused: image dimensions exceed the decode ceiling",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 像素过多，无法处理（超过 %lld 百万像素）。"
          }
        }
      }
    },
    "%@ is already configured under %@ — remove it there first." : {
      "comment" : "Model setup: refusing to tick a model id that already exists under a different provider",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is already configured under %2$@ — remove it there first."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在 %@ 下配置——请先在那里移除。"
          }
        }
      }
    },
    "%@ is hidden in SipAI." : {
      "comment" : "Scheduled-run failure: the agent is unticked in Settings → Agent Guide",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在 SipAI 中隐藏。"
          }
        }
      }
    },
    "%@ is installed but not signed in." : {
      "comment" : "Scheduled-run failure: agent CLI lacks auth",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已安装但未登录。"
          }
        }
      }
    },
    "%@ is not installed on this machine." : {
      "comment" : "Runner error when an agent binary is missing\nScheduled-run failure: agent CLI missing",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机未安装 %@。"
          }
        }
      }
    },
    "%@ is too large (over %lld MB)." : {
      "comment" : "Attachment refused: file exceeds the size ceiling",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 太大了（超过 %lld MB）。"
          }
        }
      }
    },
    "%@ is updating. Your message will be sent when the update finishes." : {
      "comment" : "Transcript, under a message sent while SipAI updates the agent's command-line tool; placeholder is the agent's label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在更新，更新完成后将发送你的消息。"
          }
        }
      }
    },
    "%@ just updated to %@" : {
      "comment" : "Sidebar, in place of the SipAI wordmark for a few seconds: a command-line tool (or SipAI itself) has just been updated; placeholders are the tool's label and the new version number",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已更新至 %@"
          }
        }
      }
    },
    "%@ label" : {
      "comment" : "Settings: label shown above an agent's messages, e.g. 'Claude Code label'",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 名称"
          }
        }
      }
    },
    "%@ listed no chat models. Enter a model ID manually below." : {
      "comment" : "Model setup: healthy response but empty list",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未返回任何对话模型。请在下方手动输入模型 ID。"
          }
        }
      }
    },
    "%@ lists its models publicly, so the key was not checked until now — and it was rejected: %@" : {
      "comment" : "Model setup: the provider's public model list hid a bad API key",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ lists its models publicly, so the key was not checked until now — and it was rejected: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的模型列表是公开的，因此密钥直到现在才被验证——而它被拒绝了：%@"
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "Plan-usage row value as counts; placeholders are the used and the limit",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ plan" : {
      "comment" : "Plan-usage card subtitle for a Claude subscription tier; placeholder is the tier ('Max', 'Pro')\nPlan-usage card subtitle; placeholder is the plan tier",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 套餐"
          }
        }
      }
    },
    "%@ publishes no model list — enter a model id manually." : {
      "comment" : "Model setup: fallback note for a provider with no /models endpoint",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未提供模型列表——请手动输入模型 ID。"
          }
        }
      }
    },
    "%@ refused the Chat only turn: %@" : {
      "comment" : "Runner error when kimi web refused a Chat only prompt; placeholders are the agent label and kimi's own sentence",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了这次“仅对话”消息：%@"
          }
        }
      }
    },
    "%@ rejected the attached file — it may not accept images or PDFs. Pick a model that does, or remove the attachment.\n\n%@" : {
      "comment" : "Error when a provider refuses a request carrying an image or PDF",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了所附文件——它可能不支持图片或 PDF。请改用支持的模型，或移除附件。\n\n%@"
          }
        }
      }
    },
    "%@ runs non-interactively here, so it approves its own tool calls. Its CLI rejects a permission mode on a headless run, so there is nothing to choose." : {
      "comment" : "Hover hint on the Kimi auto-approve chip; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在这里以非交互方式运行，会自行批准工具调用。它的 CLI 不接受在无界面运行时指定权限模式，因此这里没有可选项。"
          }
        }
      }
    },
    "%@ session" : {
      "comment" : "Source label recorded on notes generated from an agent session",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会话"
          }
        }
      }
    },
    "%@ tokens" : {
      "comment" : "Composer context chip when no window is known",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tokens"
          }
        }
      }
    },
    "%@ would put this message over %lldk characters of attached text." : {
      "comment" : "Attachment refused on an agent session: the per-message inlined-text cap; placeholders are the file name and the cap in thousands",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附加 %@ 后，这条消息的附件文本将超过 %lldk 个字符。"
          }
        }
      }
    },
    "%@'s local server did not answer: %@" : {
      "comment" : "Runner error when kimi web failed a Chat only request; placeholders are the agent label and the reason",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的本地服务器没有响应：%@"
          }
        }
      }
    },
    "%@'s local server did not start: %@" : {
      "comment" : "Runner error when kimi web could not be started for a Chat only turn; placeholders are the agent label and the reason",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的本地服务器未能启动：%@"
          }
