    "That file isn’t a zip archive SipAI can read." : {
      "comment" : "Skills: an archive that could not be listed",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该文件不是 SipAI 可读取的 zip 压缩文件。"
