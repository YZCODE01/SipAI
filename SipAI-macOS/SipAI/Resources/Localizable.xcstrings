        }
      }
    },
    "Yes, and use auto mode" : {
      "comment" : "Plan card button: approve the plan and carry on in the agent's auto mode, where routine actions run without asking",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
