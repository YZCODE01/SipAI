    },
    "The browser sign-in was not completed in time." : {
      "comment" : "Agent Guide: no login completion arrived inside the ceiling",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览器登录没有在规定时间内完成。"
          }
        }
      }
    },
    "The change applies to the next turn of every %@ session, here and in your terminal, and shows in the chip at once. A larger request draws on your plan's limits or API usage faster." : {
      "comment" : "Help card, closing paragraph; placeholder is the Codex label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改从每个 %@ 会话的下一轮开始生效，在这里和你的终端里都一样，并会立即反映在输入框下方的显示上。更大的请求会更快消耗你的套餐额度或 API 用量。"
          }
        }
      }
    },
    "The Chat section talks to AI models through their API endpoints and is billed per token. To add a model, click the model chip at the lower right of the chat box, or open Settings → Chat models. If you would rather use a subscription plan than an API key, the **Chat only** mode of an agent session gives you a similar kind of conversation — it is limited to the agent providers SipAI supports. [Learn more](sipai://settings/models)" : {
      "comment" : "Empty chat page while no chat model is configured. Keep the [Learn more](sipai://settings/models) link and the **Chat only** mode name (the mode chip's row).",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“对话”部分通过各家的 API 接口使用 AI 模型，按 token 计费。要添加模型，请点击输入框右下角的模型标签，或打开“设置 → 对话模型”。如果你更想用订阅套餐而不是 API 密钥，智能体会话的“**仅对话**”模式能提供类似的聊天体验——它仅限于 SipAI 支持的智能体提供商。[了解更多](sipai://settings/models)"
          }
        }
      }
    },
    "The codex command could not be placed at %@: %@" : {
      "comment" : "Agent Guide: the symlink for codex could not be written; placeholders are the path and the error",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法在 %1$@ 放置 codex 命令：%2$@"
          }
        }
      }
    },
    "The command-line tool did not answer, so the branch was not created." : {
      "comment" : "Branch error when the agent's own fork call got no reply",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令行工具没有响应，分支未创建。"
