    "Turned off in %@'s config (features.ultrafast_mode)" : {
      "comment" : "Codex speed: the ultrafast_mode feature is disabled in the user's codex config; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
