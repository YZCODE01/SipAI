    },
    "Yes, and don't ask again for this command in this session" : {
      "comment" : "Codex approval card answer: allow this command until the turn ends, in codex's own words",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
