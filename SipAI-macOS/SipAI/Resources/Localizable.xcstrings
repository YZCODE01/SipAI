    "%@ chooses for itself and carries on" : {
      "comment" : "Tooltip of the Skip button on the agent's question card; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 %@ 自行选择并继续"
          }
        }
      }
    },
    "%@ could not be asked to change its config. Add the line below to ~/.codex/config.toml yourself, above any [section] header." : {
      "comment" : "Help card: no codex app-server answered; placeholder is the Codex label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法让 %@ 修改自己的配置。请自行把下面这一行加入 ~/.codex/config.toml，放在任何 [section] 标题之前。"
          }
        }
      }
    },
    "%@ could not be read." : {
      "comment" : "Attachment refused: the file could not be opened or decoded",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@。"
          }
        }
      }
    },
    "%@ couldn’t be given the subfolder’s skills, so your message was sent without them." : {
      "comment" : "Runner error: Codex did not answer when handed the extra skill folders of a subfolder skill; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法把子文件夹的技能交给 %@，你的消息已在未加载这些技能的情况下发送。"
          }
        }
      }
    },
    "%@ couldn’t be given the subfolder’s skills: %@" : {
      "comment" : "Runner error: Codex refused the extra skill folders of a subfolder skill; placeholders are the agent label and Codex's words",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法把子文件夹的技能交给 %@：%@"
          }
        }
      }
    },
    "%@ couldn't load your account's speeds in time" : {
      "comment" : "Codex speed, switched on but not used for the last message: codex could not download the account's list of speeds before the message started, so it ran at standard speed; the placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未能及时载入你账号可用的速度"
          }
        }
      }
    },
    "%@ declined the change: %@" : {
      "comment" : "Help card: codex refused the config write; placeholders are the Codex label and Codex's own message",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了这项更改：%@"
          }
        }
      }
    },
    "%@ did not answer, so nothing changed." : {
      "comment" : "Edit-in-place error when the agent's own call got no reply; placeholder is the agent's label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有响应，所以没有做任何更改。"
          }
        }
      }
    },
    "%@ did not answer, so the branch was not created." : {
      "comment" : "Branch error when the agent's own fork call got no reply; placeholder is the agent's label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有响应，分支未创建。"
