        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（分支）"
          }
        }
      }
    },
    "%@ %@ is available." : {
      "comment" : "Sidebar notice beside the logo, the whole sentence (its hover and VoiceOver) of an update on offer; placeholders are SipAI or the tool's label, and the new version",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 有新版本 %2$@。"
          }
        }
      }
    },
    "%@ already has another skill called “%@”, and would use only one of the two." : {
      "comment" : "Skills: a share refused over a name clash; placeholders are the agent and the skill",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已有另一个名为“%2$@”的技能，两个中只会使用其中一个。"
          }
        }
      }
    },
    "%@ and %@" : {
      "comment" : "Joins the last agent name onto the list of the others: “A, B and C”",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@ and %lld more" : {
      "comment" : "Update-hold sheet: the named sessions plus a count of the rest; placeholders are a list and a number",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 及另外 %lld 个"
          }
        }
      }
    },
    "%@ asks what you’d like to clarify before you answer" : {
      "comment" : "Tooltip of the Chat about this button on the agent's question card; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会先问你想澄清什么，再由你作答"
          }
        }
      }
    },
    "%@ can look things up on the web but can't read or change files. Attach files with +." : {
      "comment" : "Hint under the Chat only mode row; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可以上网查找信息，但无法读取或修改文件。用 + 附加文件。"
          }
        }
      }
    },
    "%@ can’t be told this for a skill it manages itself." : {
      "comment" : "Skills: why only-when-called is disabled for a codex plugin skill; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于 %@ 自己管理的技能，无法这样设置。"
          }
        }
      }
    },
    "%@ can’t load “%@”: %@. Change that in its SKILL.md first." : {
      "comment" : "Skills: a share or fix refused over something only the user can change; placeholders are the agent, the skill and why",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 无法加载“%2$@”：%3$@。请先在其 SKILL.md 中修改。"
          }
        }
      }
    },
    "%@ can’t load “%@”: %@. Its folder is outside SipAI’s library, so change that where it lives first." : {
      "comment" : "Skills: a share or fix refused because the skill's files are not SipAI's to change; placeholders are the agent, the skill and why",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 无法加载“%2$@”：%3$@。其文件夹不在 SipAI 的技能库中，请先在原位置修改。"
          }
        }
      }
    },
    "%@ can’t load “%@”: %@. Rename its folder first." : {
      "comment" : "Skills: a share refused because the skill's folder name has a character the agent offers no skill under; placeholders are the agent, the skill and why",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 无法加载“%2$@”：%3$@。请先给其文件夹改名。"
          }
        }
      }
    },
    "%@ can’t load skills for a scheduled run yet." : {
      "comment" : "Scheduled-run failure: the agent has no way to load a skill headless; placeholder is the agent label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 暂不支持在计划运行中加载技能。"
          }
        }
      }
    },
    "%@ can’t start: %@" : {
      "comment" : "Runner error: a turn was not started because the installed command-line tool stops with an error when asked its version; placeholders are the agent label and the line the tool printed",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 无法启动：%2$@"
          }
        }
      }
    },
    "%@ chat · %@ failed" : {
      "comment" : "Sidebar notice beside the logo, one short line: a chat's turn ended on an error while the user was elsewhere; placeholders are the model provider's name and the chat group",
