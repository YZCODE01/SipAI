      }
    },
    "that kind of file" : {
      "comment" : "Stand-in for a file extension when a file has none",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该类型的文件"
          }
        }
      }
    },
    "That note no longer exists." : {
      "comment" : "Export failure: the note was deleted or moved",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该笔记已不存在。"
          }
        }
      }
    },
    "That reset is no longer available. Refresh to see your current resets." : {
      "comment" : "Settings → Usage: Codex's own words when the chosen reset was already used",
      "localizations" : {
        "zh-Hans" : {
