    },
    "Its model is not among your organization's allowed models" : {
      "comment" : "Fast mode status: the organization's model allow-list excludes the fast mode model",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它所用的模型不在你所在组织允许的模型之列"
